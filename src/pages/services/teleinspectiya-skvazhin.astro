---
export const pageTitle = 'Телеинспекция скважин';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { brand } from '../../config/brand';
import Banner from '../../components/Banner.astro';
import ServiceSidebar from '../../components/ServiceSidebar.astro';
import Image from 'astro/components/Image.astro';
import teleinspectiyaSkvazhinImg from './teleinspectiya-skvazhin.jpg';
---

<BaseLayout title={pageTitle} description={`Услуга "${pageTitle}" от ${brand.name}.`}>
  <Header slot="header" />

  <Banner title={pageTitle} />

  <section class="py-section">
    <div class="mx-auto grid max-w-site gap-8 px-4 sm:px-6 lg:grid-cols-[260px_minmax(0,1fr)] lg:items-start">
      <ServiceSidebar currentPath={Astro.url.pathname} />
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-heading text-h2 font-bold uppercase text-text">{pageTitle}</h2>
        <div class="mt-6 space-y-4 text-text-muted leading-relaxed">
          <h3 class="font-heading text-h3 font-semibold text-text">
            Телеинспекция (теледиагностика) скважин
          </h3>


          <p>Наша основная цель — предоставить единое решение всей вашей проблеме. Теле/видео диагностика артезианских/ водозаборных скважин организуется в целях оценки текущего вида скважины и пред капремонтом.</p>

          <Image src={teleinspectiyaSkvazhinImg} alt="Телеинспекция скважин" />

          <p>Эксплуатация текущего промышленного оборудования (цветной подводной камеры) может дать возможность обследовать качество фильтровой и обсадной колонны и отмерить фактическую глубину скважины.Видеоинспекция помогает обнаружить чужеродные объекты, определить точное локализацию и облик повреждения, а также выявить соответствие/ несоответствие скважины паспортным показателям.</p>
          <p>Исполнение телеинспекционного исследования дополнительно может помочь проверить качество сделанных на скважине работ. В конце выполнения видеодиагностики скважины предоставляются материалы видеообследования на цифровом хранилище и даем советы по предстоящей работе скважины. Имеющееся у нас оснащение предназначено делать исследование скважин глубиной вплоть до 200 метров.</p>


        </div>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
