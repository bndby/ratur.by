---
export const pageTitle = 'Канализация';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { brand } from '../../config/brand';
import Banner from '../../components/Banner.astro';
import ServiceSidebar from '../../components/ServiceSidebar.astro';
import Image from 'astro/components/Image.astro';
import kanalizaciyaImg from './kanalizaciya.jpg';
---

<BaseLayout title={pageTitle} description={`Услуга "${pageTitle}" от ${brand.name}.`}>
  <Header slot="header" />

  <Banner title={pageTitle} />

  <section class="py-section">
    <div class="mx-auto grid max-w-site gap-8 px-4 sm:px-6 lg:grid-cols-[260px_minmax(0,1fr)] lg:items-start">
      <ServiceSidebar currentPath={Astro.url.pathname} />
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-heading text-h2 font-bold uppercase text-text">{pageTitle}</h2>
        <div class="mt-6 space-y-4 text-text-muted leading-relaxed">

          <h3 class="font-heading text-h3 font-semibold text-text">Схема канализации для загородного дома</h3>

          <p>Из чего состоит канализация частного дома?</p>

          <p>Можно выделить всего три основных пункта:</p>
          <ul class="list-disc space-y-1 pl-5">
            <li>очистных сооружений (канализация);</li>
            <li>внутренней канализации;</li>
            <li>внешней канализации.</li>
          </ul>

          <p>Канализация представляет собой простое очистное сооружение, в котором осуществляется отстаивание стоков и перегнивание. Канализация из железобетонных колец ― это емкость из одной-трех камер, которые располагаются под землей на расстоянии 5-20 метров от фундамента дома.</p>

          <Image src={kanalizaciyaImg} alt="Канализация" />

          <p>Существует несколько способов создания канализации загородного дома из колец. Самым надежным является постройка канализации из железобетонных колец диаметром 100-150 сантиметров. Рабочий процесс схож с обыкновенной копкой колодца, разве что необходимо выкопать две или три таких шахты. Впрочем, ради экономии времени и сил можно выкопать и одну емкость для сбора жидких отходов.</p>

          <h3 class="font-heading text-h3 font-semibold text-text">Прокладка канализационных труб по участку</h3>

          <p>Сборные канализационные водопроводы и стояки объединяются для вывода сточных вод наружу. Канализация прокладывается в подвале или вдоль стены на первом этаже дома. Канализация и водоснабжение в загородном доме не проводятся по потолку или в жилых зонах.</p>

          <p>Для устройства канализационной системы используются пластиковые трубы, потому что они не нуждаются в замазке цементным раствором ― достаточно уплотнения резиновыми прокладками. Внутренняя канализация отвечает за доставку сточных вод к внешним трубам.</p>

        </div>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
