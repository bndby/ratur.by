---
export const pageTitle = 'Забивка свай под фундамент';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { brand } from '../../config/brand';
import Banner from '../../components/Banner.astro';
import ServiceSidebar from '../../components/ServiceSidebar.astro';
import Image from 'astro/components/Image.astro';
import zabivkaSvaiPodFundamentImg from './zabivka-svai-pod-fundament.jpg';
---

<BaseLayout title={pageTitle} description={`Услуга "${pageTitle}" от ${brand.name}.`}>
  <Header slot="header" />

  <Banner title={pageTitle} />

  <section class="py-section">
    <div class="mx-auto grid max-w-site gap-8 px-4 sm:px-6 lg:grid-cols-[260px_minmax(0,1fr)] lg:items-start">
      <ServiceSidebar currentPath={Astro.url.pathname} />
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-heading text-h2 font-bold uppercase text-text">{pageTitle}</h2>
        <div class="mt-6 space-y-4 text-text-muted leading-relaxed">

          <p>Среди самых популярных строительных материалов, предназначенных для возведения фундамента, лидирующее место занимают свайные опоры. Это объясняется их высокой прочностью, универсальностью и долговечностью, ведь бетонные забивные сваи подходят для строительства на самых неблагоприятных участках почвы. Например, рыхлый, глинистый и пучинистый грунт способен за короткий промежуток времени деформировать фундамент и оказать разрушительные действия на само строение. Однако установка из бетонных свай под дачный или жилой дом способна обезопасить здание от негативных воздействий природы на срок не менее 70-100 лет.</p>

          <Image src={zabivkaSvaiPodFundamentImg} alt="Забивка свай под фундамент" />
            
          <p>Компания «РАТУР-плюс» осуществляет услугу по забивки свай под фундамент для жилых и производственных объектов любого уровня сложности. У нас работают профессионалы своего дела, которые отвечают за качество выполненной работы предоставлением гарантии на срок до 10 лет.</p>
          <h3 class="font-heading text-h3 font-semibold text-text">ПРЕИМУЩЕСТВА УСТАНОВКИ ФУНДАМЕНТА НА ЗАБИВНЫХ СВАЯХ</h3>
          <ul class="list-disc space-y-1 pl-5">
            <li>Большой срок службы ЖБ свай в отличие от винтовых свай.</li>
            <li>Быстро.</li>
            <li>Высокие свайные характеристики.</li>
            <li>Можно строить, сразу после забивки свай.</li>
            <li>Забивку можно производить зимой.</li>
            <li>Сваи изготовлены на заводе по ГОСТу, имеют сертификаты качества.</li>
          </ul>
          <p>Различные способы монтажа позволяют комбинировать свайно-забивной фундамент с ленточным основанием, обвязкой из бруса, швеллера и бетона.</p>











        </div>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
