---
import { Image } from 'astro:assets';
import type { ServiceItem } from '../data/services';

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  services?: ServiceItem[];
}

const {
  topper = 'Гарантия качества',
  heading = 'Наши услуги',
  description = 'Бурение скважин и продажа бурового оборудования в Витебске и Витебской области',
  services,
} = Astro.props;
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      {topper && (
        <span class="text-topper font-bold uppercase tracking-widest text-accent">{topper}</span>
      )}
      <h2 class:list={['font-heading text-h2 font-bold uppercase text-text', topper && 'mt-2']}>{heading}</h2>
      <p class="mt-3 text-text-muted leading-relaxed">{description}</p>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {services?.map((service) => (
        <li>
          <a
            href={service.href}
            class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-lg border border-border bg-background shadow-sm transition-shadow duration-200 hover:shadow-md"
          >
            <div class="aspect-2/1 overflow-hidden bg-surface">
              <Image
                src={service.image}
                alt={service.title}
                width={600}
                height={300}
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
              {service.description && (
                <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{service.description}</p>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
